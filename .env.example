# ===================================================
# PATH FORGE — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ===================================================

# -------------------------------------------------------
# GEMINI AI (Server-side only — never sent to browser)
# -------------------------------------------------------
GEMINI_API_KEY=

# -------------------------------------------------------
# FIREBASE — Public client configuration
# These are fetched server-side by /api/authConfig and
# returned to the browser as JSON. They are public
# client-side values (not private secrets), but are
# managed via environment variables per best practice.
#
# Find these in: Firebase Console → Project Settings → Your apps → SDK setup
# -------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# -------------------------------------------------------
# ADMIN AUTHORIZATION (Server-side only)
# Comma-separated list of Google email addresses that
# have admin access to the PathForge CMS.
# -------------------------------------------------------
ADMIN_EMAILS=admin@pathforge.dev
ADMIN_SECRET_KEY=

# -------------------------------------------------------
# DATABASE (optional — for external database adapter)
# -------------------------------------------------------
DATABASE_URL=

# -------------------------------------------------------
# AI PROVIDER SETTINGS (Server-side only)
# -------------------------------------------------------
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
AI_FAST_MODEL=gemini-1.5-flash
